<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPagesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[PAGES] Arrange and Export Pages"
            android:textSize="24sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnRunOcr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[OCR] Run OCR (Marathi + English)"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[RESULTS] OCR Results Preview"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerOcrResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[EXPORT] Export Options"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnExportWord"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:textSize="18dp"
                android:text="[WORD] Export Word DOCX (Editable)"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnExportPdf"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:textSize="18dp"
                android:text="[PDF] Export PDF (Print-ready)"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnExportDtp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="[DTP] Export DTP (InDesign format)"
                android:backgroundTint="#FF9800"
                app:strokeWidth="2dp"
                app:strokeColor="@android:color/black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>
